# Copy to .env and fill in the secrets. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
APP_ACCESS_TOKEN=choose-a-long-random-token
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO
HISTORY_TOKEN_BUDGET=4000
ALLOWED_ORIGINS=["http://127.0.0.1:8000"]
# Local (no Docker): point at your local PostgreSQL.
# With docker compose, this is set automatically to the db service.
DATABASE_URL=postgresql+asyncpg://erdemakdag@localhost:5432/chatbot
